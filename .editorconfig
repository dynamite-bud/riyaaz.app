root = true

# Makefile requires tabs (not handled by Ruff/Biome)
[Makefile]
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

# YAML files (not handled by Ruff/Biome)
[*.{yml,yaml}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
